{
  "name": "xueli-weiguang",
  "version": "1.7.0",
  "private": true,
  "packageManager": "bun@1.3.0",
  "scripts": {
    "dev": "bun run build:sw && next dev",
    "build": "bun run build:sw:production && next build",
    "build:sw": "bun scripts/build-service-worker.mjs",
    "build:sw:production": "bun scripts/build-service-worker.mjs --production",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "check": "bun run lint && bun run type-check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ]
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cos-js-sdk-v5": "^1.10.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "geist": "^1.7.1",
    "motion": "^12.40.0",
    "next": "^15.0.0",
    "qcloud-cos-sts": "^3.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-fast-marquee": "^1.6.5",
    "react-image-crop": "^11.0.10",
    "tailwind-merge": "^3.3.1",
    "web-push": "3.6.7",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "postcss": "^8.5.6",
    "sharp": "0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.8",
    "workbox-build": "7.4.1",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1"
  }
}
